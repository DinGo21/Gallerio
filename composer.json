{
    "name": "gallerio/gallerio",
    "description": "A curated image gallery built with vanilla PHP and Bootstrap.",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Gallerio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "config": {
        "sort-packages": true
    }
}
